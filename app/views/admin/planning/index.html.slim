/ app/views/admin/planning/index.html.slim
- planning_start_hour = 7
- planning_end_hour   = 21
- planning_hours      = (planning_start_hour...planning_end_hour)
- total_minutes       = (planning_end_hour - planning_start_hour) * 60
.container-fluid.px-4.py-8 data-controller="planning planning-button modal info-card" data-planning-start-hour=planning_start_hour data-planning-end-hour=planning_end_hour
  h1.text-3xl.font-bold.mb-6 Planning des interventions
  / Boutons de sauvegarde (sticky en haut quand des modifications sont présentes)
  .fixed.right-3.top-4.z-40.flex.justify-end.hidden data-planning-target="saveButton"
    .bg-white.rounded-lg.shadow-xl.border-2.border-orange-400.p-2.flex.items-center.gap-4
      .flex.flex-col.items-center.gap-2
        .flex.items-center.gap-2
          .bg-orange-100.text-orange-800.px-3.py-1.rounded-full.font-bold.text-sm
            span Modifications non sauvegardées :
            span data-planning-target="pendingCount" 0
        .flex.gap-2
          button.bg-green-500.text-white.px-6.py-3.rounded-lg.hover:bg-green-600.shadow-lg.flex.items-center.gap-2.font-medium data-action="click->planning#saveAllChanges" type="button"
            span 💾
            span Sauvegarder
          button.bg-gray-500.text-white.px-4.py-3.rounded-lg.hover:bg-gray-600.shadow-lg.flex.items-center.gap-2.font-medium data-action="click->planning#cancelAllChanges" type="button"
            span ↺
            span Annuler

  / Sélecteur de date
  .flex.justify-center.bg-white.rounded-lg.shadow.p-4.mb-6.gap-4
    / Flèche jour précédent
    button.p-2.hover:bg-gray-100.rounded-full.transition-colors data-action="click->planning-button#prevDay" type="button"
      .flex.items-center.gap-2.bg-green-300.p-2.rounded-2xl.w-max
          i.fas.fa-chevron-left.text-gray-600
          p Précedent
    = form_with url: admin_planning_path, method: :get, local: true, class: "flex gap-4 items-center", data: { turbo: false } do |f|
      label.text-sm.font-medium.text-gray-700 Date
      = f.date_field :date, value: @selected_date, class: "px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", onchange: "this.form.submit()"
    / Flèche jour suivant + Bouton fermer
    .flex.items-center.gap-2
      button.p-2.hover:bg-gray-100.rounded-full.transition-colors data-action="click->planning-button#nextDay" type="button"
        .flex.items-center.gap-2.bg-green-300.p-2.rounded-2xl.justify-end.w-max
          p Suivant
          i.fas.fa-chevron-right.text-gray-600

  / Layout : Sidebar + Timeline
  .flex.gap-6
    / Sidebar gauche : Chantiers à planifier
    .w-80.flex-shrink-0
      .bg-white.rounded-lg.shadow.p-4.sticky style="top: 20px;"
        h2.text-lg.font-bold.mb-4 Chantiers à planifier

        - unless @chantiers.empty?
          .space-y-2 data-chantiers-list="true"
            - @chantiers.each do |chantier|
              .bg-gray-50.border.border-gray-300.rounded.p-3.cursor-move data-chantier-id=chantier.id data-chantier-duration=chantier.duration data-chantier-name=chantier.name
                .font-medium.text-sm.flex.items-center.gap-1
                  = chantier.name
                  - if chantier.copy?
                    span.text-orange-400.text-xs title="Copie d'un chantier"
                      i class="fa-solid fa-copy"
                .text-xs.text-gray-500 = chantier.location
                .text-xs.text-blue-600.mt-1
                  = "📏 #{chantier.duration} min (#{chantier.duration_in_hours}h)"
                - if chantier.scheduled_date.present?
                  .text-xs.text-green-600.mt-1 = "📅 #{l(chantier.scheduled_date, format: :long)}"
                - else
                  .text-xs.text-gray-400.italic.mt-1 Aucune date prévue
                .text-xs.text-gray-500

                .flex.mt-2.items-center.gap-2
                  - if chantier.extra_equipment || chantier.two_operators
                    p.text-xs ⚠️
                  - if chantier.extra_equipment
                    i class="fa-solid fa-screwdriver-wrench text-xs text-black opacity-90"
                  - if chantier.two_operators
                    i class="fa-solid fa-people-arrows text-xs text-black"

        - else
          p.text-gray-500.text-sm.italic Aucun chantier disponible

    / Timeline principale
    .flex-1.overflow-x-auto.min-w-0
      .bg-white.rounded-lg.shadow.p-4
        / En-tête des heures
        .flex.mb-2
          .w-48.flex-shrink-0
            / Espace vide pour aligner avec les noms de camions
          .flex-1.flex.timeline-track
            - planning_hours.each do |hour|
              .flex-1.text-left.pl-1.text-xs.font-medium.text-gray-600.border-l.border-gray-200
                = "#{hour}h"

        / Lignes de camions
        - @trucks.each do |truck|
          - assignment = @daily_assignments[truck.id]

          .flex.border-t.border-gray-200.relative style="height: 100px;"
            / Colonne : Nom du camion + Conducteur
            .w-48.flex-shrink-0.flex.flex-col.justify-center.px-3.bg-gray-50.border-r.border-gray-200
              .font-medium.text-sm.mb-2 = truck.name

              - if assignment
                / Conducteur assigné
                .flex.items-center.justify-between.bg-green-50.border.border-green-200.rounded.px-2.py-1
                  .flex.items-center.gap-1
                    span.text-xs 👤
                    span.text-xs.font-medium = assignment.user.email.split('@').first
                  .flex.gap-1
                    button.text-blue-500.hover:text-blue-700 data-action="click->modal#open" data-truck-id=truck.id data-date=@selected_date data-assignment-id=assignment.id type="button" title="Modifier l'assignation"
                      | ✎
                    = button_to "×", admin_daily_assignment_path(assignment), method: :delete, data: { turbo_confirm: "Retirer ce conducteur ?" }, class: "text-red-500 hover:text-red-700 font-bold", title: "Retirer le conducteur"
              - else
                / Pas de conducteur
                button.w-full.text-xs.text-gray-500.hover:text-blue-600.border.border-dashed.border-gray-300.hover:border-blue-400.rounded.px-2.py-1.transition-colors data-action="click->modal#open" data-truck-id=truck.id data-date=@selected_date type="button"
                  | + Assigner

            / Timeline des cards camions
            .flex-1.relative.timeline-track data-truck-timeline="true" data-truck-id=truck.id data-date=@selected_date
              / Quadrillage — mêmes divs que l'en-tête, donc alignement garanti
              .absolute.inset-0.flex.pointer-events-none
                - planning_hours.each do |hour|
                  .flex-1.border-l.border-gray-200

              / Interventions de ce camion
              - truck_interventions = @interventions_by_truck[truck.id] || []
              - truck_interventions.each do |intervention|
                - minutes_from_start = ((intervention.start_time.hour - planning_start_hour) * 60) + intervention.start_time.min
                - left_percent  = (minutes_from_start / total_minutes.to_f) * 100
                - width_percent = (intervention.duration_in_minutes / total_minutes.to_f) * 100

                .absolute.rounded.px-2.py-1.text-xs.text-white.cursor-move.group.shadow class=(intervention.chantier.two_operators ? "bg-orange-400 border border-orange-500" : "bg-green-400 border border-green-500") style="left: #{left_percent.round(4)}%; width: #{width_percent.round(4)}%; top: 15px; height: 70px; overflow: hidden;" data-intervention-id=intervention.id data-chantier-id=intervention.chantier_id data-chantier-duration=intervention.chantier.duration data-action="mousedown->info-card#startClick click->info-card#open"
                  .flex.gap-1
                    .font-medium.truncate = intervention.chantier.name
                    - if intervention.chantier.extra_equipment
                      i class="fa-solid fa-screwdriver-wrench text-xs text-gray-600 opacity-90" ⚠️
                  .text-xs.opacity-90
                    = "#{intervention.start_time.strftime('%H:%M')} - #{intervention.end_time.strftime('%H:%M')}"
                  .text-xs.opacity-90
                    = "#{intervention.chantier.description.to_s.first(20)}"
                  button.absolute.top-1.right-1.text-sm.text-white.hover:text-red-900.opacity-0.group-hover:opacity-100.transition-opacity data-delete-intervention=intervention.id type="button"
                    | ×
  = render 'admin/chantiers/info_modal'

  / Modal d'assignation
  #assignment-modal.hidden.fixed.inset-0.flex.items-center.justify-center.z-50 class="bg-black/40"
    .bg-white.rounded-lg.shadow-xl.p-6.w-96
      h3.text-xl.font-bold.mb-4 Assigner un conducteur

      = form_with model: [:admin, DailyAssignment.new], local: true, id: "assignment-form", class: "space-y-4" do |f|
        = f.hidden_field :truck_id, id: "modal-truck-id"
        = f.hidden_field :date, id: "modal-date"

        .space-y-2
          = f.label :user_id, "Conducteur", class: "block text-sm font-medium text-gray-700"
          = f.select :user_id, @available_users.map { |u| [u.email, u.id] }, { include_blank: "Sélectionner un conducteur" }, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"

        .flex.justify-end.gap-2
          button.px-4.py-2.text-gray-700.bg-gray-200.rounded.hover:bg-gray-300 type="button" data-action="click->modal#close"
            | Annuler
          = f.submit "Assigner", class: "px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"


/ Styles additionnels
css:
  .timeline-track {
    min-width: 700px;
  }
