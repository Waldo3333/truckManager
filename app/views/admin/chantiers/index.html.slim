/ app/views/admin/chantiers/index.html.slim
.container.mx-auto.px-4.py-8
  .flex.justify-between.items-center.mb-6
    h1.text-3xl.font-bold Gestion des chantiers
    = link_to "➕ Nouveau chantier", new_admin_chantier_path, class: "bg-green-500 text-white px-4 py-2 rounded hover:bg-blue-600"

  / Header colonnes (desktop uniquement)
  .hidden.md:flex.px-4.py-2.text-xs.font-medium.text-gray-500.uppercase.border-b.border-gray-200.mb-1
    .w-1/4 Nom
    .w-1/3 Lieu
    .w-1/6 Durée
    .w-1/6 Prévu le
    .w-1/6.text-right Actions

  / Liste des chantiers
  .space-y-2
    - @chantiers.each do |chantier|

      / Desktop : ligne flex
      .hidden.md:flex.items-center.bg-white.rounded-lg.shadow-sm.px-4.py-3.border.border-gray-100
        .w-1/4.font-medium.text-gray-900.flex.items-center.gap-2
          = chantier.name
          - if chantier.has_copy?
            span.text-blue-400.text-xs title="Ce chantier est cloné"
              i class="fa-solid fa-copy"
        .w-1/3.text-sm.text-gray-600 = chantier.location
        .w-1/6.text-sm
          = "#{chantier.duration} min"
          span.text-gray-400.text-xs = " (#{chantier.duration_in_hours}h)"
        .w-1/6.text-sm.text-gray-500
          - if chantier.scheduled_date
            = chantier.scheduled_date.strftime("%d/%m/%Y")
          - else
            span.text-gray-400.italic Aucune date
        .w-1/6.flex.justify-end.items-center.gap-3
          - if chantier.has_copy?
            = button_to admin_chantier_path(chantier.copy_chantier), method: :delete, data: { turbo_confirm: "Supprimer la copie ?" }, class: "text-red-400 hover:text-red-600 text-sm bg-transparent border-0 cursor-pointer p-0" do
              i.fa-solid.fa-copy
          - else
            = button_to duplicate_admin_chantier_path(chantier), method: :post, data: { turbo_confirm: "Dupliquer ce chantier ?" }, class: "text-green-600 hover:text-green-800 text-sm bg-transparent border-0 cursor-pointer p-0" do
              i.fa-solid.fa-copy
          = button_to edit_admin_chantier_path(chantier), class: "text-blue-600 hover:text-blue-800 cursor-pointer text-sm"
            i class="fa-solid fa-pen"
          = button_to admin_chantier_path(chantier), method: :delete, data: { turbo_confirm: "Êtes-vous sûr ?" }, class: "text-red-600 hover:text-red-800 text-sm bg-transparent border-0 cursor-pointer p-0"
            i class="fa-solid fa-trash"
      / Mobile : carte
      .md:hidden.bg-white.rounded-lg.shadow.p-4.border.border-gray-200
        .mb-3
          .flex.items-center.gap-2.mb-1
            h3.text-lg.font-bold.text-gray-900 = chantier.name
            - if chantier.has_copy?
              span.text-blue-400.text-xs title="Ce chantier est cloné" 🔗
          .flex.items-center.text-sm.text-gray-600
            span.mr-1 📍
            = chantier.location
        .space-y-2.mb-4
          .flex.justify-between.items-center
            span.text-sm.text-gray-500 Durée
            span.font-medium.text-gray-900
              = "#{chantier.duration} min"
              span.text-gray-500.text-sm.ml-1 = "(#{chantier.duration_in_hours}h)"
          .flex.justify-between.items-center
            span.text-sm.text-gray-500 Prévu le
            - if chantier.scheduled_date
              span.font-medium.text-gray-900 = chantier.scheduled_date.strftime("%d/%m/%Y")
            - else
              span.text-gray-400.italic.text-sm Aucune date prévue
        .flex.gap-2.pt-3.border-t.border-gray-200
          = link_to edit_admin_chantier_path(chantier), class: "flex-1 bg-blue-500 text-white text-center py-2 px-4 rounded hover:bg-blue-600 transition" do
            span ✏️ Modifier
          = button_to duplicate_admin_chantier_path(chantier), method: :post, data: { turbo_confirm: "Dupliquer ce chantier ?" }, class: "flex-1 bg-green-500 text-white py-2 px-4 rounded hover:bg-green-600 transition" do
            span 🔗 Dupliquer
          = button_to admin_chantier_path(chantier), method: :delete, data: { turbo_confirm: "Êtes-vous sûr ?" }, class: "flex-1 bg-red-500 text-white py-2 px-4 rounded hover:bg-red-600 transition" do
            span 🗑️ Supprimer
