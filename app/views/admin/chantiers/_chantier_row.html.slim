/ Desktop
.hidden.md:flex.items-center.px-4.py-3.border-b.border-gray-100.last:border-0.hover:bg-gray-50.transition
  .w-1/4.font-medium.text-gray-900.flex.items-center.gap-2
    = chantier.name
    - if chantier.has_copy?
      span.text-blue-400.text-xs title="Ce chantier est cloné"
        i class="fa-solid fa-copy text-xs"
  .w-1/3.text-sm.text-gray-600 = chantier.location
  .w-1/6.text-sm
    = "#{chantier.duration} min"
    span.text-gray-400.text-xs = " (#{chantier.duration_in_hours}h)"
  .w-1/6.text-sm.text-gray-500
    - if chantier.scheduled_date
      = chantier.scheduled_date.strftime("%d/%m/%Y")
    - else
      span.text-gray-400.italic Aucune date
  .w-1/6.flex.justify-end.items-center.gap-3
    - if chantier.has_copy?
      = button_to admin_chantier_path(chantier.copy_chantier), method: :delete, data: { turbo_confirm: "Supprimer la copie ?" }, class: "text-red-400 hover:text-red-600 text-sm bg-transparent border-0 cursor-pointer p-0" do
        i.fa-solid.fa-copy
    - else
      = button_to duplicate_admin_chantier_path(chantier), method: :post, data: { turbo_confirm: "Dupliquer ce chantier ?" }, class: "text-green-600 hover:text-green-800 text-sm bg-transparent border-0 cursor-pointer p-0" do
        i.fa-solid.fa-copy
    = link_to edit_admin_chantier_path(chantier), class: "text-blue-600 hover:text-blue-800 cursor-pointer text-sm"
      i class="fa-solid fa-pen"
    = button_to admin_chantier_path(chantier), method: :delete, data: { turbo_confirm: "Êtes-vous sûr ?" }, class: "text-red-600 hover:text-red-800 text-sm bg-transparent border-0 cursor-pointer p-0" do
      i class="fa-solid fa-trash"

/ Mobile
.md:hidden.px-4.py-4.border-b.border-gray-100.last:border-0
  .mb-2
    .flex.items-center.gap-2
      h3.text-base.font-bold.text-gray-900 = chantier.name
      - if chantier.has_copy?
        span.text-blue-400.text-xs
          i class="fa-solid fa-copy text-xs"
    .text-sm.text-gray-500
      span.mr-1 📍
      = chantier.location
  .flex.justify-between.text-sm.text-gray-500.mb-3
    span = "#{chantier.duration} min (#{chantier.duration_in_hours}h)"
    - if chantier.scheduled_date
      span = chantier.scheduled_date.strftime("%d/%m/%Y")
    - else
      span.italic Aucune date
  .flex.gap-2
    - if chantier.has_copy?
      = button_to admin_chantier_path(chantier.copy_chantier), method: :delete, data: { turbo_confirm: "Supprimer la copie ?" }, class: "bg-red-100 text-red-400 py-2 px-3 rounded hover:bg-red-200 transition text-sm" do
        i.fa-solid.fa-copy
    - else
      = button_to duplicate_admin_chantier_path(chantier), method: :post, data: { turbo_confirm: "Dupliquer ce chantier ?" }, class: "bg-green-100 text-green-600 py-2 px-3 rounded hover:bg-green-200 transition text-sm" do
        i.fa-solid.fa-copy
    = link_to edit_admin_chantier_path(chantier), class: "flex-1 bg-blue-500 text-white text-center py-2 px-4 rounded hover:bg-blue-600 transition text-sm" do
      i class="fa-solid fa-pen"
    = button_to admin_chantier_path(chantier), method: :delete, data: { turbo_confirm: "Êtes-vous sûr ?" }, class: "flex-1 bg-red-500 text-white py-2 px-4 rounded hover:bg-red-600 transition text-sm" do
      i class="fa-solid fa-trash"
